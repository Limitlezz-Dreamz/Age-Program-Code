{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logwarden",
  "version": "0.1.0",
  "identifier": "io.logwarden.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Logwarden",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi", "dmg", "app"],
    "category": "Utility",
    "shortDescription": "Offline EVTX threat hunting",
    "longDescription": "Logwarden is a cross-platform desktop app for offline Windows EVTX threat hunting with Sigma rules, built-in detections, and case-local SQLite storage.",
    "copyright": "Copyright © Logwarden contributors",
    "resources": {
      "../resources/mappings": "resources/mappings",
      "../resources/builtin-rules": "resources/builtin-rules",
      "../resources/mitre": "resources/mitre",
      "../resources/event-descriptions.yml": "resources/event-descriptions.yml"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
